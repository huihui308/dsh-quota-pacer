{
  "name": "dsh-quota-pacer",
  "version": "0.1.0",
  "description": "DSH plugin: pace OpenCode Go and DeepSeek official quotas against elapsed time, with projections and limit alerts.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs",
    "LICENSE",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "opencode-go",
    "deepseek",
    "quota",
    "usage",
    "cost"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huihui308/dsh-quota-pacer.git"
  },
  "homepage": "https://github.com/huihui308/dsh-quota-pacer#readme",
  "bugs": {
    "url": "https://github.com/huihui308/dsh-quota-pacer/issues"
  },
  "author": "huihui308"
}
